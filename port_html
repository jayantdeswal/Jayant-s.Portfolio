  railLinks.forEach(a => a.classList.toggle('on', a.getAttribute('href') === '#'+cur));
  const tl = $('#tl');
  if (tl){
    const r = tl.getBoundingClientRect();
    const prog = Math.max(0, Math.min(1, (innerHeight*0.72 - r.top) / r.height));
    $('#tl-fill').style.height = (prog * (r.height - 12)) + 'px';
    $$('.ev', tl).forEach(ev => {
      ev.classList.toggle('on', ev.getBoundingClientRect().top < innerHeight*0.72);
    });
  }
}
