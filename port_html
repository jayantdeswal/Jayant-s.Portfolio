/* ---------- reveal + counters + bars ---------- */
const io = new IntersectionObserver(es => {
  es.forEach(e => {
    if (!e.isIntersecting) return;
    e.target.classList.add('in');
    $$('[data-count]', e.target).forEach(runCount);
    $$('.fill', e.target).forEach(f => f.style.width = f.dataset.w + '%');
    io.unobserve(e.target);
  });
}, {threshold:.14, rootMargin:'0px 0px -40px'});
$$('.rv').forEach(el => io.observe(el));

function runCount(el){
  if (el.dataset.done) return; el.dataset.done = 1;
  const target = parseFloat(el.dataset.count), dec = +(el.dataset.dec||0);
  const suffix = el.querySelector('em') ? el.querySelector('em').outerHTML : '';
  if (RM) return;
  const dur = 1100, t0 = performance.now();
  (function step(now){
    const p = Math.min(1, (now-t0)/dur), e = 1 - Math.pow(1-p, 3);
    el.innerHTML = (target*e).toFixed(dec) + suffix;
    if (p < 1) requestAnimationFrame(step);
  })(t0);
}

