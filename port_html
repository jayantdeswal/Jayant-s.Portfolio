const k = $('#cmdk'), kin = $('#k-input'), klist = $('#k-list');
let sel = 0, shown = CMDS;
if (!/Mac|iPhone|iPad/.test(navigator.platform)) $('#kbd-key').textContent = 'Ctrl K';
function renderK(){
  const q = kin.value.trim().toLowerCase();
  shown = q ? CMDS.filter(c => (c.t+' '+c.h).toLowerCase().includes(q)) : CMDS;
  sel = 0;
  klist.innerHTML = shown.length
    ? shown.map((c,i)=>`<li class="${i===0?'sel':''}" data-i="${i}"><svg><use href="#${c.i}"/></svg>${c.t}<span class="hint">${c.h}</span></li>`).join('')
    : `<li style="color:var(--muted)">No matches</li>`;
}
function openK(){ k.classList.add('on'); kin.value=''; renderK(); kin.focus(); document.body.style.overflow='hidden'; }
function closeK(){ k.classList.remove('on'); document.body.style.overflow=''; }
function runK(c){ if(!c) return; closeK();
  if (c.s){ document.querySelector(c.s).scrollIntoView({behavior: RM?'auto':'smooth'}); }
  else if (c.u){ window.open(c.u,'_blank','noopener'); }
  else if (c.a){ c.a(); }
}
