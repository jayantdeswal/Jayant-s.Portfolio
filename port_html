/* ---------- ECG canvas ---------- */
(function(){
  const c = $('#ecg'); if (!c) return;
  const ctx = c.getContext('2d');
  let w, h, dpr = Math.min(devicePixelRatio||1, 2), t = 0, mouseAmp = 1;
  function size(){ w = c.clientWidth; h = c.clientHeight; c.width = w*dpr; c.height = h*dpr; ctx.setTransform(dpr,0,0,dpr,0,0); }
  size(); addEventListener('resize', size);
  addEventListener('mousemove', e => { mouseAmp = 1 + (1 - e.clientY/innerHeight)*0.6; }, {passive:true});
  // one heartbeat period, expressed as offsets from the baseline
  function beat(p){
    if (p < .12) return Math.sin(p/.12*Math.PI)*4;          // P wave
    if (p < .17) return 0;
    if (p < .20) return -(p-.17)/.03*10;                    // Q
    if (p < .25) return -10 + (p-.20)/.05*52;               // R
    if (p < .30) return 42 - (p-.25)/.05*60;                // S
    if (p < .36) return -18 + (p-.30)/.06*18;
    if (p < .55) return Math.sin((p-.36)/.19*Math.PI)*11;   // T wave
    return 0;
  }
  function draw(){
    ctx.clearRect(0,0,w,h);
    const base = h*0.62, period = 260, grad = ctx.createLinearGradient(0,0,w,0);
    grad.addColorStop(0,'rgba(53,224,186,0)');
    grad.addColorStop(.14,'rgba(53,224,186,.55)');
    grad.addColorStop(.6,'rgba(125,155,255,.55)');
    grad.addColorStop(1,'rgba(53,224,186,0)');
    ctx.strokeStyle = grad; ctx.lineWidth = 1.6; ctx.lineJoin='round'; ctx.lineCap='round';
    ctx.shadowColor = 'rgba(53,224,186,.45)'; ctx.shadowBlur = 8;
    ctx.beginPath();
    for (let px = 0; px <= w; px += 2){
      const p = (((px + t) % period) / period);
      const y = base - beat(p)*mouseAmp;
      px ? ctx.lineTo(px,y) : ctx.moveTo(px,y);
    }
    ctx.stroke(); ctx.shadowBlur = 0;
    if (!RM) t += 1.3;
    requestAnimationFrame(draw);
  }
  draw();
})();

