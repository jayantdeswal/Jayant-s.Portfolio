addEventListener('keydown', e => {
  if ((e.metaKey||e.ctrlKey) && e.key.toLowerCase()==='k'){ e.preventDefault(); k.classList.contains('on') ? closeK() : openK(); return; }
  if (e.key === 'Escape'){ closeK(); closeModal(); return; }
  if (!k.classList.contains('on')) return;
  if (e.key === 'ArrowDown' || e.key === 'ArrowUp'){
    e.preventDefault();
    sel = (sel + (e.key==='ArrowDown'?1:-1) + shown.length) % shown.length;
    $$('#k-list li').forEach((li,i)=>li.classList.toggle('sel', i===sel));
    const cur = $$('#k-list li')[sel]; if (cur) cur.scrollIntoView({block:'nearest'});
  }
  if (e.key === 'Enter'){ e.preventDefault(); runK(shown[sel]); }
});
